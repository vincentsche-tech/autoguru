{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "https://www.listkraft.com/(.*)", "destination": "https://listkraft.com/$1", "permanent": true },
    { "source": "/ebay-title-builder", "destination": "/ebay-seo-title-builder", "permanent": true },
    { "source": "/ebay-title-builder.html", "destination": "/ebay-seo-title-builder", "permanent": true },
    { "source": "/ebay-seo-auto-parts-guide", "destination": "/ebay-seo-guide", "permanent": true },
    { "source": "/ebay-seo-auto-parts-guide.html", "destination": "/ebay-seo-guide", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
